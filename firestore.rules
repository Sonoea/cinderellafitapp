rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global collectionGroups (Cleaned)
    match /{path=**}/closetItems/{itemId} {
      allow read: if true;
    }
    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }
    match /{path=**}/plushies/{itemId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /closetItems/{itemId} {
        allow read: if (request.auth != null && request.auth.uid == userId) || (resource != null && resource.data.isPublic == true);
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
        );
        
        match /likes/{likeId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null &&
            (request.auth.uid == resource.data.userId || request.auth.uid == userId);
        }
      }

      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null;
      }

      match /plushies/{plushieId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /profileSlugs/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
