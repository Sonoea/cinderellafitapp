rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /plushies/{plushieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /closetItems/{itemId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likeId} {
          allow read: if true;
          allow write: if request.auth != null;
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null &&
            (request.auth.uid == resource.data.userId || request.auth.uid == userId);
        }
      }
    }

    // ギャラリー全体表示用（collectionGroup クエリ対応）
    match /{path=**}/closetItems/{itemId} {
      allow read: if true;
    }

    match /{path=**}/likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    match /profileSlugs/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
